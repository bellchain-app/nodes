{
  "format": 1,
  "id": "custom.volumen-spitze",
  "version": "1.0.0",
  "label": {
    "de": "Volumen-Spitze",
    "en": "Volume spike"
  },
  "description": {
    "de": "Volumen über dem Vielfachen des Schnitts",
    "en": "Volume above a multiple of its average"
  },
  "icon": "chart-column",
  "sentence": {
    "de": "{factor} × Ø {length}",
    "en": "{factor} × avg {length}"
  },
  "inputs": [
    {
      "id": "volume",
      "type": "number",
      "label": {
        "de": "Volumen",
        "en": "Volume"
      }
    }
  ],
  "settings": [
    {
      "id": "length",
      "label": {
        "de": "Kerzen",
        "en": "Candles"
      },
      "default": 20,
      "min": 2,
      "max": 500,
      "integer": true
    },
    {
      "id": "factor",
      "label": {
        "de": "Faktor",
        "en": "Factor"
      },
      "default": 2.5,
      "min": 1,
      "max": 20,
      "step": 0.5
    }
  ],
  "outputs": [
    {
      "id": "out",
      "type": "signal",
      "label": {
        "de": "Spitze",
        "en": "Spike"
      },
      "formula": "volume > sma(volume, length) * factor"
    }
  ],
  "tests": [
    {
      "name": "2.5 × SMA 20",
      "expectAt": {
        "18": {
          "out": false
        },
        "27": {
          "out": false
        },
        "28": {
          "out": true
        }
      },
      "expectLast": {
        "out": false
      }
    },
    {
      "name": "4 × SMA 20",
      "settings": {
        "factor": 4
      },
      "expectAt": {
        "28": {
          "out": false
        },
        "104": {
          "out": true
        }
      }
    }
  ]
}
